<nav class="shop__nav">
  <div class="container py-2 flex ai-center gap-2">
    <div class="shop__nav--left shop__nav--logo">
      <%= render "shared/logo" %>
    </div>

    <div class="shop__nav--middle flex ai-center gap-2">
      <%= render "shared/ransack", 
        ransack: { 
          q: Ransack::Search.new(Product, params: { q: { name_cont: "" } }),
          url: root_path, 
          class_name: "shop__nav--search", 
          search_box: [ { searchables: :name_cont } ] 
        } 
      %>

      <%= render "shared/button", 
        variant: "light", 
        shape: "square",
        class_name: "shop__nav--hamburger radius-lg", 
        data: { action: "click->modal#toggle" }, 
        title: "Menu", 
        icon: "hamburger-3" 
      %>

      <%# <ul class="flex gap-2"> %>
      <%# <li><a href="/">Shop</a></li> %>
      <%# <li><a href="/Categories">Categories</a></li> %>
      <%# <li><a href="/deals">Deals</a></li> %>
      <%# <li><a href="/whats-new">What's New</a></li> %>
      <%# <li><a href="/delivery">Delivery</a></li> %>
      <%# </ul> %>
    </div>

    <div class="shop__nav--right">
      <ul class="flex jc-end gap-2 ai-center">
        <% if !user_signed_in? %>
          <li>
            <%= render "shared/button", 
            element: "a",
            path: new_user_session_path,
            variant: "primary", 
            class_name: "shop__nav--login", 
            title: "Sign In" %>
          </li>
        <% end %>

        <li><a href="/wishlist"><%= render "shared/icon", name: "heart" %></a></li>
        <li>
          <%= link_to cart_path, class: "shop__nav--cart", data: { controller: "cart" } do %>
            <%= render "shared/icon", name: "cart" %>

            <span id="cart-count" class="shop__nav--cart__count radius-circle grid place-center"></span>
          <% end %>
        </li>

        <% if user_signed_in? %>
          <li class="shop__nav--profile__container">
            <%= render "shared/nav/profile" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>