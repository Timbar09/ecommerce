<% q = ransack[:q] %>
<% url = ransack[:url] %>
<% filter = ransack[:filter] if ransack[:filter].present? %>

<%= tag.div class: "ransack__form--container flex ai-center gap-2", 
  data: { controller: "ransack #{filter.present? ? 'modal' : ''}" } do %>
  <%= render "shared/button", 
    variant: "light", 
    class_name: "ransack__search--button",
    data: { ransack_target: "searchButton" },
    title: "Search", 
    icon: "search" 
  %>

  <%= search_form_for q, url: url, class: "ransack__form radius-lg flex gap-1", data: { turbo_frame: "results" } do |f| %>
    <div class="ransack__search--container flex flex-col gap-1">
      <% ransack[:search_box].each do | box | %>
        <% is_number = box[:searchables].is_a?(Symbol) && box[:searchables].to_s.end_with?("_gteq") %>
        <% placeholder = box[:placeholder] || "Search..." %>
        <% search_icon = box[:icon] || "search" %>

        <div class="ransack__search radius-lg gap-1" data-ransack-target="search">
          <%= f.label box[:searchables], class: "sr-only", value: "Search" %>
          <%= f.search_field box[:searchables], 
          oninput: 'this.form.requestSubmit()', 
          class: "ransack__search--input radius-lg btn", 
          placeholder: placeholder,
          autocomplete: "off", 
          aria: { label: "Search" }, 
          data: { ransack_target: "input", ransack_value_type: is_number ? "number" : "text" }
        %>

          <div class="ransack__search--input__icon grid place-center pr-1">
            <%= render "shared/icon", name: search_icon %>
          </div>
        </div>
      <% end %>
    </div>

    <% if filter.present? %>
      <div class="ransack__filter-container">
        <%= render "shared/button", 
          element: "button", 
          variant: "light", 
          class: "ransack__filter--button radius-lg", 
          data: { action: "click->modal#toggle" }, 
          title: "Filter", 
          icon: "filter" 
        %>

        <%= render "shared/modal", type: "options" do %>
          <div class="ransack__filter modal__list radius-lg p-1 flex flex-col gap-1">
            <%= f.label :fulfilled_in, "Filter by Fulfillment", class: "sr-only" %>

            <% filter.each do |option| %>
              <%= f.label "#{option[:predicate]}_#{option[:value]}", 
                option[:label], 
                class: "ransack__filter--field modal__list--link" do %>
                <%= f.check_box option[:predicate], 
                  { multiple: true, 
                    onchange: "this.form.requestSubmit()", 
                    data: { ransack_target: "checkbox" } 
                  }, 
                  option[:value], nil %>
                <%= option[:label] %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>