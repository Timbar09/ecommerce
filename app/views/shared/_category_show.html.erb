<% is_admin = request.path.include?("admin") %>

<div class="category__show">
  <header class="category__show--header">
    <div class="category__show--header__container flex ai-center">
      <div class="category__show--header__content flex-1 p-2">
        <h1><%= category.name %></h1>

        <p class="category__show--header__content--description"><%= category.description %></p>

        <% if local_assigns[:header_actions] %>
          <ul class="category__show--header__actions flex-inline ai-center gap-1 radius-lg">
            <% @header_actions.each_with_index do |action, index| %>
              <li class="category__show--header__actions--item category__show--header__actions--item__<%= index == 0 ? "left" : index == 1 ? "middle" : "right" %>">
                <% if action[:method] == :delete %>
                  <%= button_to action[:path].call(category), method: action[:method], class: "p-2" do %>
                    <%= render "shared/icon", name: action[:icon] %>
                    <span><%= action[:label] %></span>
                  <% end %>
                <% else %>
                  <%= link_to action[:path].call(category), class: "p-2" do %>
                    <%= render "shared/icon", name: action[:icon] %>
                    <span><%= action[:label] %></span>
                  <% end %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>

      <div class="category__show--header__image">
        <%= image_tag category.display_medium_image, class: "radius-lg" %>
      </div>
    </div>
  </header>

  <div class="category__show--body p-2">
    <h2><%= category.name %> Collection</h2>

    <div class="category__show--body__container flex gap-2">
      <div class="category__show--filter">
        <h3 class="mb-2">Filter Products</h3>

        <%= render "shared/ransack", 
          ransack: {
            q: @q,
            url: category_path(category),
            search_box: [
              { searchables: :price_gteq, placeholder: "Min Price", icon: "currency-dollar" }, 
              { searchables: :price_lteq, placeholder: "Max Price", icon: "currency-dollar" }
            ],
          } 
        %>
      </div>

      <%= turbo_frame_tag :results, 
      class: "category__show--body__product--list__container  px-2 pb-2 radius-lg" do %>
        <% if @products.any? %>
          <ul class="category__show--body__product--list flex flex-wrap gap-2">
            <% @products.each do |product| %>
              <% path = is_admin ? admin_product_path(product) : product_path(product) %>

              <li class="category__show--body__product--item radius-lg">
                <%= image_tag product.display_small_image, class: "radius-lg" %>
                <%= link_to path, data: { turbo_frame: "_top" } do %>
                  <h3><%= product.name %></h3>
                <% end %>
                <span class="category__show--body__product--item__price">
                  <%= number_to_currency(product.price) %>
                </span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p>No products found.</p>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
