<section class="cart">
  <div class="container px-1">
    <h1>Cart</h1>

    <div id="cart-errors"></div>

    <div data-controller="cart" cartAuthenticated="<%= user_signed_in? %>">
      <ul class="cart__total" id="cart-total"></ul>

      <ul class="cart__list" id="cart-list"></ul>

      <button data-action="click->cart#checkout" class="btn">Checkout</button>
      <button data-action="click->cart#clearCart" class="btn">Clear Cart</button>
    </div>
  </div>
</section>