<header class="admin__content--header p-2 flex jc-between ai-center">
  <h2>
    <% if local_assigns[:specific_title] %>
      <%= specific_title %>
    <% end %>

    <%= yield :title %>
  </h2>

  <nav class="flex ai-center gap-2">
    <% if local_assigns[:ransack] %>
      <%= render "shared/ransack", ransack: ransack %>
    <% end %>

    <% if local_assigns[:new] %>
      <%= render "shared/button", element: "a", path: new[:path], title: new[:title], icon: "plus",
        variant: "primary" %>
    <% end %>

    <%= render "shared/nav/profile" %>
  </nav>
</header>