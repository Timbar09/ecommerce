<% content_for :title, "Stock" %>

<section class="admin__content flex flex-col pb-2">
  <%= render 'admin/page_header', specific_title: @product.name, new: { path: new_admin_product_stock_path, title: "Add New Stock" } %>

  <div class="section__table--container full-height px-2">
    <% if @product.stocks.any? %>
      <%= render partial: 'shared/table', locals: { headers: @table_headers, list: @admin_stocks, actions: @table_actions } %>
    <% else %>
      <%= turbo_frame_tag :results, class: "p-2" do %>
        <% if params[:q].present? %>
          <p class="text-center">No stock found matching your search criteria.</p>
        <% else %>
          <p class="text-center">No stock available for this product.</p>
        <% end %>
      <% end %>
    <% end %>
  </div>
</section>
