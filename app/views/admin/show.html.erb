<% content_for :title, "Admin Profile" %>

<section class="admin__content flex flex-col pb-2">
  <h1 class="admin__content--title">Admin Profile</h1>

  <div class="admin__content--profile flex gap-1">
    <div class="admin__content--profile__image">
      <%= image_tag @admin.display_medium_image, class: "admin__content--profile__image" %>
    </div>

    <div class="admin__content--profile__info">
      <p class="admin__content--profile__email"><%= @admin.role %></p>
    </div>
  </div>

  <div class="admin__content--profile__actions flex gap-1">
    <li>
      <%= link_to edit_user_registration_path, class: "btn btn__tertiary", title: "Edit" do %>
        <%= render "shared/icon", name: "edit" %>
      <% end %>
    </li>
  </div>

  <ul class="">
    <li class="admin__content--admin__list--header flex gap-1">
      <strong class="flex-1">Profile Picture</strong>
      <strong class="flex-1">Name</strong>
      <strong class="flex-1">Role</strong>
    </li>
    <% @users.each do |user| %>
      <li class="flex gap-1">
        <div class="flex-1">
          <%= image_tag user.display_thumb_image, style: "max-width: 50px; max-height: 50px;" %>
        </div>
        <span class="flex-1"><%= user.first_name %></span>
        <span class="flex-1"><%= user.role.humanize %></span>
      </li>
    <% end %>
  </ul>
</section>