<% content_for :title, "Orders" %>

<section class="admin__content flex flex-col pb-2">
  <%= render 'admin/page_header', path: new_admin_order_path, title: "Add New Order", ransack: { q: @q, url: admin_orders_path, searchables: :customer_email_or_address_cont } %>

  <div class="section__table--container full-height px-2">
    <%= render partial: 'shared/table', locals: { headers: @table_headers, list: @orders, pagy: @orders_pagy, actions: @table_actions, class_names: "px-2", id: "orders-table" } %>
  </div>
</section>
