<%= content_for :title, "Create New Account" %>

<section class="form__page">
  <%= render "admin/form_page_header" %>

  <div class="form__container flex flex-col jc-center">
    <h2 class="form__title">Get Started<span>.</span></h2>

    <%- if controller_name != 'sessions' %>
      <p>Already have an account? <%= link_to "Sign in", new_session_path(resource_name), class: "form__link--primary" %>.</p>
    <% end %>

    <%= form_with(
      model: resource, 
      as: resource_name, 
      url: registration_path(resource_name), 
      html: { class: "form flex flex-col gap-1" },
      data: { controller: "form" }
    ) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <%= render "step_one", f: f %>

      <%= render "step_two", f: f %>

    <% end %>
  </div>
</section>